{
  "$description": "Kesher Club design tokens (spec Tab 2, 'Jerusalem stone and night sky'). W3C DTCG format. Colour tokens carry their dark value under $extensions['club.kesher.modes'].dark; the light value is $value. Tints and money aliases are references resolved at build time, never hand-copied.",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "#FBF8F3",
        "$description": "App background",
        "$extensions": { "club.kesher.modes": { "dark": "#0E1523" } }
      },
      "surface": {
        "$value": "#FFFFFF",
        "$description": "Cards, sheets",
        "$extensions": { "club.kesher.modes": { "dark": "#172033" } }
      },
      "sunken": {
        "$value": "#F3EEE5",
        "$description": "Inputs, list wells",
        "$extensions": { "club.kesher.modes": { "dark": "#0A101B" } }
      },
      "stone": {
        "$value": "#E2D6C2",
        "$description": "Brand band, card art base. Ink on stone 10.97:1",
        "$extensions": { "club.kesher.modes": { "dark": "#2A2418" } }
      }
    },
    "text": {
      "primary": {
        "$value": "#14233B",
        "$description": "Body, headings. 14.87:1 light / 16.14:1 dark on bg.canvas",
        "$extensions": { "club.kesher.modes": { "dark": "#EEF1F7" } }
      },
      "secondary": {
        "$value": "#56627A",
        "$description": "Meta, captions. 5.79:1 light / 8.1:1 dark on bg.canvas",
        "$extensions": { "club.kesher.modes": { "dark": "#A3ADC2" } }
      },
      "disabled": {
        "$value": "#8A94A6",
        "$description": "Disabled labels only (exempt from AA). 3.06:1",
        "$extensions": { "club.kesher.modes": { "dark": "#5D677B" } }
      },
      "onAction": {
        "$value": "#FFFFFF",
        "$description": "Text on primary buttons. 5.93:1 light / 7.78:1 dark on action.primary",
        "$extensions": { "club.kesher.modes": { "dark": "#0E1523" } }
      }
    },
    "action": {
      "primary": {
        "$value": "#1E5BD8",
        "$description": "Primary buttons, links, focus. 5.93:1 on white",
        "$extensions": { "club.kesher.modes": { "dark": "#7FA8FF" } }
      },
      "primaryHover": {
        "$value": "#184BB4",
        "$description": "Hover / pressed",
        "$extensions": { "club.kesher.modes": { "dark": "#9DBCFF" } }
      },
      "primarySubtle": {
        "$value": "#E7EEFC",
        "$description": "Selected rows, chips",
        "$extensions": { "club.kesher.modes": { "dark": "#1B2B4F" } }
      }
    },
    "accent": {
      "gold": {
        "$value": "#B8761F",
        "$description": "Club badge, perks, icons >= 24 px only. 3.72:1 (non-text)",
        "$extensions": { "club.kesher.modes": { "dark": "#E0A852" } }
      }
    },
    "status": {
      "success": {
        "$value": "#177A45",
        "$description": "Settled, approved. 5.38:1 light / 7.88:1 dark on surface",
        "$extensions": { "club.kesher.modes": { "dark": "#5CC98A" } }
      },
      "warning": {
        "$value": "#A55A00",
        "$description": "Pending, low balance. 5.17:1 light / 8.88:1 dark on surface",
        "$extensions": { "club.kesher.modes": { "dark": "#F2B45C" } }
      },
      "danger": {
        "$value": "#C0362C",
        "$description": "Declines, errors, freeze. 5.52:1 light / 7.13:1 dark on surface",
        "$extensions": { "club.kesher.modes": { "dark": "#FF8A80" } }
      },
      "successSubtle": {
        "$value": { "color": "{color.status.success}", "on": "{color.bg.surface}", "alpha": 0.08 },
        "$description": "Banner and badge fills: 8% tint of success on surface (16% in dark). Computed by the kesher/color/tint transform.",
        "$extensions": {
          "club.kesher.modes": { "dark": { "color": "{color.status.success}", "on": "{color.bg.surface}", "alpha": 0.16 } }
        }
      },
      "warningSubtle": {
        "$value": { "color": "{color.status.warning}", "on": "{color.bg.surface}", "alpha": 0.08 },
        "$description": "Banner and badge fills: 8% tint of warning on surface (16% in dark). Computed by the kesher/color/tint transform.",
        "$extensions": {
          "club.kesher.modes": { "dark": { "color": "{color.status.warning}", "on": "{color.bg.surface}", "alpha": 0.16 } }
        }
      },
      "dangerSubtle": {
        "$value": { "color": "{color.status.danger}", "on": "{color.bg.surface}", "alpha": 0.08 },
        "$description": "Banner and badge fills: 8% tint of danger on surface (16% in dark). Computed by the kesher/color/tint transform.",
        "$extensions": {
          "club.kesher.modes": { "dark": { "color": "{color.status.danger}", "on": "{color.bg.surface}", "alpha": 0.16 } }
        }
      }
    },
    "border": {
      "default": {
        "$value": "#E3DCD0",
        "$description": "Card and input borders (decorative; 3:1 not required)",
        "$extensions": { "club.kesher.modes": { "dark": "#2A3550" } }
      },
      "strong": {
        "$value": "#8A94A6",
        "$description": "Input borders, focused-off state (3:1 non-text). 3.06:1",
        "$extensions": { "club.kesher.modes": { "dark": "#5D677B" } }
      },
      "focus": {
        "$value": "#1E5BD8",
        "$description": "2 px focus ring + 2 px offset",
        "$extensions": { "club.kesher.modes": { "dark": "#7FA8FF" } }
      }
    },
    "money": {
      "in": {
        "$value": "{color.status.success}",
        "$description": "Incoming amounts, with a '+' sign (never colour alone). Alias of status.success."
      },
      "out": {
        "$value": "{color.text.primary}",
        "$description": "Outgoing amounts, with a '-' sign. Alias of text.primary."
      }
    },
    "overlay": {
      "scrim": {
        "$value": "#0E15237A",
        "$description": "Scrim behind sheets and modals: rgba(14,21,35,.48) in both modes",
        "$extensions": { "club.kesher.modes": { "dark": "#0E15237A" } }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "latin": { "$value": ["Inter", "system-ui", "sans-serif"], "$description": "Latin: Inter variable (400/500/600/700), bundled" },
      "hebrew": { "$value": ["Rubik", "system-ui", "sans-serif"], "$description": "Hebrew: Rubik (400/500/700), bundled" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 32, "unit": "px" }, "lineHeight": { "value": 40, "unit": "px" }, "fontWeight": "{font.weight.bold}" },
      "$description": "display 32 (40) / 700"
    },
    "title1": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 24, "unit": "px" }, "lineHeight": { "value": 32, "unit": "px" }, "fontWeight": "{font.weight.bold}" },
      "$description": "title-1 24 (32) / 700"
    },
    "title2": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 20, "unit": "px" }, "lineHeight": { "value": 28, "unit": "px" }, "fontWeight": "{font.weight.semibold}" },
      "$description": "title-2 20 (28) / 600"
    },
    "headline": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 17, "unit": "px" }, "lineHeight": { "value": 24, "unit": "px" }, "fontWeight": "{font.weight.semibold}" },
      "$description": "headline 17 (24) / 600"
    },
    "body": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 16, "unit": "px" }, "lineHeight": { "value": 24, "unit": "px" }, "fontWeight": "{font.weight.regular}" },
      "$description": "body 16 (24) / 400"
    },
    "callout": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 15, "unit": "px" }, "lineHeight": { "value": 22, "unit": "px" }, "fontWeight": "{font.weight.regular}" },
      "$description": "callout 15 (22) / 400"
    },
    "caption": {
      "$value": { "fontFamily": "{font.family.latin}", "fontSize": { "value": 13, "unit": "px" }, "lineHeight": { "value": 18, "unit": "px" }, "fontWeight": "{font.weight.medium}" },
      "$description": "caption 13 (18) / 500. Minimum text size is 13 px"
    },
    "micro": {
      "$value": {
        "fontFamily": "{font.family.latin}",
        "fontSize": { "value": 11, "unit": "px" },
        "lineHeight": { "value": 14, "unit": "px" },
        "fontWeight": "{font.weight.semibold}",
        "letterSpacing": { "value": 0.04, "unit": "em" },
        "textTransform": "uppercase"
      },
      "$description": "micro 11 (14) / 600 uppercase +4% tracking, for overlines and labels only"
    },
    "moneyHero": {
      "$value": {
        "fontFamily": "{font.family.latin}",
        "fontSize": { "value": 40, "unit": "px" },
        "lineHeight": { "value": 44, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "fontFeatureSettings": "tnum"
      },
      "$description": "Money hero (balance on Home): 40 (44) / 700, tabular figures"
    },
    "moneyHeroSymbol": {
      "$value": {
        "fontFamily": "{font.family.latin}",
        "fontSize": { "value": 24, "unit": "px" },
        "lineHeight": { "value": 44, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "fontFeatureSettings": "tnum"
      },
      "$description": "Currency symbol next to the money hero: 60% size (24 px), baseline-aligned"
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing on a 4 px base",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } }
  },
  "layout": {
    "$type": "dimension",
    "gutter": {
      "mobile": { "$value": "{space.4}", "$description": "Screen gutter on mobile" },
      "web": { "$value": "{space.6}", "$description": "Screen gutter on web" }
    },
    "cardPadding": { "$value": "{space.4}", "$description": "Card padding" },
    "sectionGap": { "$value": "{space.6}", "$description": "Section gap" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" }, "$description": "Chips, badges" },
    "md": { "$value": { "value": 10, "unit": "px" }, "$description": "Inputs, buttons" },
    "lg": { "$value": { "value": 16, "unit": "px" }, "$description": "Cards, sheets" },
    "xl": { "$value": { "value": 24, "unit": "px" }, "$description": "Bottom-sheet top corners" },
    "full": { "$value": { "value": 9999, "unit": "px" }, "$description": "Avatars, pills" },
    "card": { "$value": { "value": 12, "unit": "px" }, "$description": "Physical-card illustration, at the ISO ID-1 ratio 85.6 x 53.98" }
  },
  "borderWidth": {
    "$type": "dimension",
    "default": { "$value": { "value": 1, "unit": "px" }, "$description": "1 px border.default on cards and dividers" },
    "input": { "$value": { "value": 1, "unit": "px" }, "$description": "Inputs: 1 px border.strong" },
    "focus": { "$value": { "value": 2, "unit": "px" }, "$description": "Focus: 2 px border.focus ring" },
    "focusOffset": { "$value": { "value": 2, "unit": "px" }, "$description": "Focus ring offset" },
    "error": { "$value": { "value": 2, "unit": "px" }, "$description": "Error state: 2 px status.danger" }
  },
  "elev": {
    "$type": "shadow",
    "$description": "Light only; dark uses surface tone steps instead. No border-plus-shadow on the same element.",
    "1": {
      "$value": [
        { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": "#14233B0F" },
        { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 1, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": "#14233B0A" }
      ],
      "$description": "Cards: 0 1 2 rgba(20,35,59,.06), 0 1 1 rgba(20,35,59,.04)"
    },
    "2": {
      "$value": [
        { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": "#14233B1A" }
      ],
      "$description": "Menus and popovers: 0 4 12 rgba(20,35,59,.10)"
    },
    "3": {
      "$value": [
        { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 12, "unit": "px" }, "blur": { "value": 32, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": "#14233B29" }
      ],
      "$description": "Sheets and modals: 0 12 32 rgba(20,35,59,.16)"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 120, "unit": "ms" }, "$description": "Press, toggle; also the Reduce Motion cross-fade" },
      "base": { "$value": { "value": 200, "unit": "ms" }, "$description": "Fade, colour" },
      "slow": { "$value": { "value": 320, "unit": "ms" }, "$description": "Sheet, page; card flip" },
      "signature": { "$value": { "value": 900, "unit": "ms" }, "$description": "Money-sent check (Lottie, plays once)" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit": { "$value": [0.3, 0, 1, 1] }
    }
  },
  "icon": {
    "$type": "dimension",
    "size": {
      "sm": { "$value": { "value": 16, "unit": "px" } },
      "md": { "$value": { "value": 20, "unit": "px" } },
      "lg": { "$value": { "value": 24, "unit": "px" } }
    },
    "stroke": { "$value": { "value": 1.75, "unit": "px" }, "$description": "Lucide icons stroke width" },
    "merchantFallback": { "$value": { "value": 32, "unit": "px" }, "$description": "Merchant logo fallback circle on bg.sunken" }
  }
}
